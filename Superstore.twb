      <aliases enabled='yes' />
      <column caption='Missing order dates' datatype='integer' name='[Calculation_0489890969763840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([Order Date]) THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Missing Ship Date' datatype='integer' name='[Calculation_0489890970292225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([Ship Date]) THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Missing Profit ' datatype='integer' name='[Calculation_0489890970533890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([Profit]) THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Missing Postal Code' datatype='integer' name='[Calculation_0489890975444995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([Postal Code]) THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Missing Sale' datatype='integer' name='[Calculation_0489890975830020]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([Sales]) THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Profit Margin' datatype='real' default-format='p0.0%' name='[Calculation_1351908139331584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='Total Orders' datatype='integer' default-format='N' name='[Calculation_1351908139757569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order ID])' />
      </column>
      <column caption='Top Bottom N filter' datatype='boolean' name='[Calculation_1351908154658820]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(SUM([Profit]), &apos;desc&apos;) &lt;= [Parameters].[Parameter 1351908154216450]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
